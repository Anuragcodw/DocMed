# ============================================================
# DocMed — Environment Variables Example
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================================

# ── Django Core ─────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ─────────────────────────────────────────────────
# SQLite (local dev, no setup needed):
DATABASE_URL=sqlite:///db.sqlite3

# MySQL (production):
# DATABASE_URL=mysql://username:password@localhost:3306/docmed_db

# PostgreSQL (Render recommended):
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# ── AI / Gemini ──────────────────────────────────────────────
# Get free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash
AI_ANALYSIS_ENABLED=False

# ── Payment: Razorpay ────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_CURRENCY=INR

# ── Payment: Stripe ──────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# ── Email ────────────────────────────────────────────────────
# Console (local dev — prints to terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@docmed.com

# SMTP (Gmail example — for production):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── Social Auth (Google) ─────────────────────────────────────
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ── Media & Storage ──────────────────────────────────────────
MEDICAL_REPORT_MAX_SIZE_MB=10

# Cloudinary (optional — for production file storage):
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# USE_CLOUDINARY=False

# AWS S3 (optional):
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=ap-south-1

# ── Security ─────────────────────────────────────────────────
SECURE_HSTS_SECONDS=0         # Set to 31536000 in production
SECURE_SSL_REDIRECT=False      # Set to True in production
SESSION_COOKIE_SECURE=False    # Set to True in production
CSRF_COOKIE_SECURE=False       # Set to True in production

# ── Redis (optional — for caching & Celery) ──────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Sentry (optional — error tracking) ──────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=